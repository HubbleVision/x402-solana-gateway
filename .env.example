# Copy this file:
# cp .env.example .env
# Then modify to suit your needs

# =============================================================================
# Basic Configuration
# =============================================================================

# Running environment: development | production
NODE_ENV=development

# Service port
PORT=3000

# =============================================================================
# Gateway YAML Configuration
# =============================================================================

# Gateway configuration file path
# Path relative to project root
GATEWAY_CONFIG_PATH=./config/gateway.yaml

# =============================================================================
# Request/Response Logging Configuration
# =============================================================================

# Whether to enable detailed request/response logging
# true: Print request headers, body, response headers, body (for development debugging)
# false: Print only basic information (recommended for production)
DEBUG_REQUEST_RESPONSE=false

# Log level
# Options: error | warn | info | debug
LOG_LEVEL=info

# =============================================================================
# Coinbase CDP Configuration (Optional)
# =============================================================================

# CDP API Key ID (required for mainnet with CDP facilitator)
# Format: organizations/{org_id}/apiKeys/{key_id}
# Get it from: https://portal.cdp.coinbase.com/
# CDP_API_KEY_ID=organizations/your-org-id/apiKeys/your-key-id

# CDP private key (required for mainnet with CDP facilitator)
# Format: 0xYour64ByteEd25519PrivateKey or without 0x prefix
# Note: This is sensitive information, never commit to version control
# CDP_API_KEY_SECRET=0xYour64ByteEd25519PrivateKey

# =============================================================================
# Additional Configuration
# =============================================================================

# Public base URL for discoverable endpoints
# PUBLIC_BASE_URL=https://your-domain.com
