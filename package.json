{
  "name": "x402-gateway",
  "version": "1.0.0",
  "description": "X402 Payment Gateway for Hubble API Services",
  "main": "dist/server/app.js",
  "author": "Hubble Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && (cp -r config dist/ 2>/dev/null || echo 'config directory not found, skipping') && (cp -r public dist/ 2>/dev/null || echo 'public directory not found, skipping')",
    "clean": "rm -rf dist",
    "start": "PORT=3101 npx tsx src/server/simplified.ts",
    "dev": "PORT=3101 npx tsx --watch src/server/simplified.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coinbase/x402": "0.7.0",
    "@hono/node-server": "^1.14.4",
    "dotenv": "^16.6.1",
    "hono": "^4.8.3",
    "x402-hono": "0.7.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.7",
    "@types/node": "^24.0.7",
    "prettier": "^3.3.3",
    "typescript": "^5.3.3"
  }
}
